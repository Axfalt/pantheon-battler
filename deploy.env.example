# Modèle de réglages pour scripts/deploy-web.sh.
# Copiez ce fichier en deploy.env (jamais versionné : voir .gitignore) et remplissez-le.

# Méthode d'envoi : rsync, scp ou sftp (accès SSH), ou ftp (avec lftp, seulement si
# l'hébergeur n'offre que FTP).
DEPLOY_METHOD=rsync

# Dossier de destination sur le serveur, la barre finale comprise.
#   rsync, scp, sftp : utilisateur@hôte:/chemin/vers/arene/
#   ftp              : ftp://hôte/chemin/vers/arene/
DEPLOY_TARGET=utilisateur@exemple.org:/var/www/arene/

# Port SSH ou FTP, si ce n'est pas celui par défaut (facultatif).
DEPLOY_PORT=

# Adresse publique de la page, affichée après l'envoi.
PUBLIC_URL=https://exemple.org/arene/

# FTP seulement :
# FTP_USER=
# FTP_PASSWORD=
